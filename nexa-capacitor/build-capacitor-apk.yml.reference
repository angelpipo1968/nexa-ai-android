name: Build Android APK

on:
  # Trigger manually from the Actions tab
  workflow_dispatch:
  # Also build automatically when pushing to main
  push:
    branches: [ main ]
    paths:
      - 'android/**'
      - 'www/**'
      - 'capacitor.config.json'
      - 'package.json'
      - '.github/workflows/build-apk.yml'

jobs:
  build:
    name: Build Debug APK
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Setup Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3
        with:
          packages: |
            platforms;android-34
            build-tools;34.0.0

      - name: Install Capacitor deps
        run: |
          npm install --no-package-lock --no-save \
            @capacitor/core@6 @capacitor/android@6 @capacitor/cli@6
          npm install

      - name: Verify Capacitor config
        run: npx cap verify android || true

      - name: Sync Capacitor (copy www + config to native project)
        run: npx cap sync android

      - name: Make gradlew executable
        working-directory: android
        run: chmod +x ./gradlew

      - name: Build debug APK
        working-directory: android
        run: ./gradlew assembleDebug --no-daemon --stacktrace

      - name: List built APK
        working-directory: android
        run: |
          find . -name "*.apk" -type f -exec ls -lh {} \;
          echo "APK_PATH=$(find . -name '*.apk' -type f | head -1)" >> $GITHUB_ENV

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: nexa-ai-debug-apk
          path: android/app/build/outputs/apk/debug/*.apk
          retention-days: 30
          if-no-files-found: error

      - name: Show download instructions
        run: |
          echo ""
          echo "============================================================"
          echo "APK built successfully!"
          echo ""
          echo "To download:"
          echo "  1. Go to the Actions tab of this repo on GitHub"
          echo "  2. Click the latest 'Build Android APK' run"
          echo "  3. Scroll to the 'Artifacts' section at the bottom"
          echo "  4. Click 'nexa-ai-debug-apk' to download a ZIP"
          echo "  5. Unzip and install app-debug.apk on your Android phone"
          echo "============================================================"
          echo ""
          echo "Server URL configured: http://192.168.50.158:3000"
          echo "Make sure your phone is on the same WiFi network as the server."
