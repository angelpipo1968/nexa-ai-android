# ═══════════════════════════════════════
# NEXA AI — Configuracion de Entorno
# Copia a .env.local y rellena con tus valores
# ═══════════════════════════════════════

# --- SERVIDOR ---
PORT=7860
PYTHONUNBUFFERED=1
FENIX_ENABLED=true
NEXA_DEV_MODE=false

# --- SEGURIDAD ---
NEXA_API_SECRET=genera_un_secreto_fuerte_de_32_chars
NEXA_AUTH_DISABLED=false

# --- PROTOCOLO FENIX ---
ECHO_VAULT_PATH=/data/nexa_echo_vault
GPG_KEY_ID=tu_key_id_8_chars
GPG_PASSPHRASE=tu_passphrase_segura

# --- OLLAMA ---
OLLAMA_HOST_URL=http://127.0.0.1:11434

# --- PROVEEDORES DE AI (Server-Side — NUNCA exponer al frontend) ---
GEMINI_API_KEY=tu_gemini_key
GOOGLE_AI_API_KEY=tu_gemini_key
GEMINI_API_KEY_BACKUP=tu_gemini_backup_key
GROQ_API_KEY=tu_groq_key
OPENAI_API_KEY=tu_openai_key
OPENROUTER_API_KEY=tu_openrouter_key
NVIDIA_API_KEY=tu_nvidia_key
DEEPSEEK_API_KEY=tu_deepseek_key
ANTHROPIC_API_KEY=tu_anthropic_key
CLAUDE_API_KEY=tu_claude_key
XIAOMI_API_KEY=tu_xiaomi_key

# --- VISION MODEL (Server-Side) ---
HUGGINGFACE_API_KEY=tu_huggingface_token

# --- GOOGLE ---
FIREBASE_API_KEY=tu_firebase_key
GOOGLE_CSE_API_KEY=tu_google_cse_key
GOOGLE_FLIGHTS_API_KEY=tu_google_flights_key

# --- BUSQUEDA Y RESEARCH ---
BRAVE_API_KEY=tu_brave_key
TAVILY_API_KEY=tu_tavily_key
SERPAPI_KEY=tu_serpapi_key
PEXELS_API_KEY=tu_pexels_key

# --- LOTERIA (Magayo) ---
MAGAYO_API_KEY=tu_magayo_key

# --- AVIATION (Flight Data) ---
AVIATIONSTACK_API_KEY=tu_aviationstack_key

# --- CODE EXECUTION ---
E2B_API_KEY=tu_e2b_key

# --- TTS (TEXT-TO-SPEECH) ---
ELEVENLABS_API_KEY=tu_elevenlabs_key
ELEVENLABS_WSEC=tu_elevenlabs_wsec

# --- GENERACION DE VIDEO (Server-Side) ---
RUNWAY_API_KEY=tu_runway_ml_key
STABILITY_API_KEY=tu_stability_ai_key
LUMA_API_KEY=tu_luma_dream_machine_key
PIKA_API_KEY=tu_pika_labs_key
KLING_ACCESS_KEY=tu_kling_access_key
KLING_SECRET_KEY=tu_kling_secret_key

# --- PANEL ADMIN ---
ADMIN_SECRET=nexa_ai_pro_secret_2024

# --- SUPABASE ---
SUPABASE_SERVICE_KEY=tu_supabase_service_key
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key

# --- FRONTEND (Variables NEXT_PUBLIC_ si se exponen al browser) ---
NEXT_PUBLIC_BACKEND_URL=https://tu-proyecto.vercel.app

# Capacitor Android backend URL (needed because static export doesn't include API routes)
NEXA_BACKEND_URL=https://tu-proyecto.vercel.app

# Ollama local (solo para dev)
NEXT_PUBLIC_OLLAMA_URL=http://127.0.0.1:11434

# --- BASE DE DATOS ---
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- DEEP SEARCH ---
DEEP_SEARCH_ENABLED=true

# --- DEPLOYMENT ---
VERCEL_TOKEN=tu_vercel_token

# --- MONITOREO (Sentry) ---
SENTRY_ORG=tu_sentry_org
SENTRY_PROJECT=tu_sentry_project
NEXT_PUBLIC_SENTRY_DSN=https://tu_dsn@sentry.io/tu_project_id
SENTRY_AUTH_TOKEN=tu_sentry_auth_token

# --- INTEGRACION DE LARK (FEISHU) & DIFY ---
LARK_APP_ID=tu_lark_app_id
LARK_APP_SECRET=tu_lark_app_secret
DIFY_API_KEY=tu_dify_api_key
LARK_BOT_PROVIDER=nexa # 'nexa' o 'dify'

