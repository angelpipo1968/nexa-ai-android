<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="12dp">
    
    <TextView
        android:id="@+id/widget_chat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXA PRO"
        android:textColor="#00E5A0"
        android:textSize="14sp"
        android:textStyle="bold" />
    
    <TextView
        android:id="@+id/widget_chat_hint"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/widget_chat_title"
        android:layout_marginTop="8dp"
        android:background="#16213E"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:text="Tap to chat..."
        android:textColor="#888888"
        android:textSize="13sp" />
    
    <ImageButton
        android:id="@+id/widget_chat_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/widget_chat_hint"
        android:layout_marginTop="8dp"
        android:src="@android:drawable/ic_menu_send"
        android:background="#00E5A0"
        android:contentDescription="Send message"
        android:padding="8dp" />
</RelativeLayout>
